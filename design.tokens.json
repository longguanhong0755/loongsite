{
  "version": 2,
  "_note": "loongsite 设计契约的唯一事实源。CSS 的 :root 变量、DESIGN.md 的契约表、scripts/check-design.mjs（源码级）与 scripts/audit-design.py（渲染级）都从这里取值。改数值只改这里，然后 `npm run design:sync` 同步文档，`npm run verify` 全站校验。",
  "spacingScale": [4, 8, 12, 16, 24, 32, 40, 48, 64, 88, 96],
  "_spacingScaleNote": "块级间距刻度（margin/padding 的块方向应落在此刻度上）",
  "gapAllowed": [1, 2, 3, 4, 6, 8, 12, 16, 24, 32, 48, "clamp(24px, 4vw, 48px)"],
  "_gapAllowedNote": "gap 允许值（含 1-6px 的光学微间距；7/9/10/17/22 等一律不许）。clamp 仅限 hero 卡片的响应式主间距",
  "fontSizeAllowed": ["12px", "13px", "14px", "16px", "18px", "1rem", "1.125rem", "1.25rem", "1.5rem", "0.88em", "inherit", "clamp(2.5rem, 1.9rem + 3.5vw, 3.5rem)", "clamp(1rem, 0.9rem + 0.5vw, 1.25rem)", "clamp(1.75rem, 1.3rem + 1.6vw, 2rem)", "clamp(1.5rem, 1.1rem + 1.4vw, 2rem)", "clamp(1.125rem, 0.95rem + 1vw, 1.5rem)"],
  "_fontSizeNote": "字号只许这些值（12/13/14/16/18 或等值 rem；标题用列出的 clamp）。新增字号必须先加进这里",
  "fontWeightAllowed": ["400", "500", "600", "inherit"],
  "_fontWeightNote": "字重上限 600（DESIGN.md §3）",
  "radiusAllowed": ["var(--radius)", "var(--radius-sm)", "var(--radius-xs)", "var(--radius-2xs)", "999px", "50%", "inherit", "2px", "0 0 var(--radius-sm) var(--radius-sm)"],
  "_radiusAllowedNote": "border-radius 只许这些（字面量 4/5/6/8/12/16px 一律不许，必须走 var）",
  "radiusMatrix": {
    "pill": {
      "value": "999px",
      "role": "所有交互控件（按钮/胶囊/徽章/导航项/回到顶部/吐司）"
    },
    "circle": {
      "value": "50%",
      "role": "纯圆（圆钮/头像盘/圆点）"
    },
    "panel": {
      "value": "16px",
      "token": "--radius",
      "role": "一级面板（卡片/玻璃/指标条/代码窗）"
    },
    "sub": {
      "value": "12px",
      "token": "--radius-sm",
      "role": "面板内层与媒体（图标砖/前言图/二维码/翻页块）"
    },
    "small": {
      "value": "8px",
      "token": "--radius-xs",
      "role": "小容器 32 档（标签/复制按钮/面包屑/notice）"
    },
    "micro": {
      "value": "4px",
      "token": "--radius-2xs",
      "role": "微型 ≤24px（游戏小图标/行内 code/kbd/仓库树行）"
    },
    "hairline": {
      "value": "2px",
      "role": "线状与方点图形（汉堡线/私有方点）"
    }
  },
  "_radiusMatrixRule": "嵌套律：16 → 12 → 8 → 4 内层永远小一档；胶囊与圆形独立，不参与嵌套",
  "controlHeights": {
    "lg": 44,
    "md": 36,
    "sm": 32,
    "fab": 40,
    "nav": 56
  },
  "_controlHeightsNote": "控件高度档位：lg 主按钮/静态 chip/复制圆钮；md 小按钮/筛选胶囊/导航项；sm 徽章/标签/小复制钮/面包屑；fab 浮动圆钮；nav 导航条",
  "pageRhythm": {
    "headToFirstBlock": 48,
    "toolbarToGrid": 16,
    "contentToActions": 24,
    "labelToRow": 12
  },
  "_pageRhythmNote": "页头→首个内容块 48（与导航→返回 的 48 对称）；工具条→网格 16；内容→动作行 24；分组标签→按钮行 12；区块之间 88 不变",
  "rowGaps": {
    "toolbar": 8,
    "meta": 8,
    "chipPair": 8,
    "buttonRow": 12
  },
  "contrastMin": 4.5,
  "motion": {
    "_note": "动效令牌唯一事实源。full=完整体验；light=自动轻量降级（系统减动效 / 省流量或 2G-慢网 / 核心数≤2 / 内存≤2GB），不是关掉效果，而是时长更短、位移更小、视差关掉。对应 CSS 变量 --m-*，由 html[data-motion=light] 覆盖；JS 只写整数序号（如 --rise-i），所有数值由 CSS 算出，避免 JS 里出现第二套数字。?motion=full|light 可强制覆盖。",
    "ease": {
      "soft": "cubic-bezier(0.22, 0.61, 0.36, 1)",
      "snap": "cubic-bezier(0.2, 0.7, 0.2, 1)"
    },
    "roles": "悬停色/光 = dur1；边框、跨页淡化、导航压缩 = dur2；滚动浮现、到达后块上浮 = dur3；dist1/2/3 = 小/中/大位移；stagger = 逐项错峰步长；parallax = 景深视差强度（0 关掉）；spot = 光斑强度系数",
    "tiers": {
      "full": {
        "dur1": "0.16s",
        "dur2": "0.24s",
        "dur3": "0.5s",
        "dist1": "6px",
        "dist2": "16px",
        "dist3": "28px",
        "stagger": "0.028s",
        "parallax": "1",
        "spot": "1"
      },
      "light": {
        "dur1": "0.1s",
        "dur2": "0.14s",
        "dur3": "0.3s",
        "dist1": "3px",
        "dist2": "8px",
        "dist3": "14px",
        "stagger": "0.016s",
        "parallax": "0",
        "spot": "0.7"
      }
    }
  },
  "sourceContract": {
    ".btn": {
      "height": "44px",
      "padding": "0 16px"
    },
    ".btn-sm": {
      "height": "36px",
      "padding": "0 12px"
    },
    ".chip-copy": {
      "width": "44px",
      "height": "44px",
      "border-radius": "50%"
    },
    ".filter-chip": {
      "height": "36px",
      "padding": "0 16px",
      "gap": "8px",
      "border-radius": "999px"
    },
    ".filter-row": {
      "gap": "8px",
      "margin": "0 0 16px"
    },
    ".btn-row": {
      "gap": "12px"
    },
    ".hero-contacts": {
      "gap": "12px"
    },
    ".meta-row": {
      "gap": "8px"
    },
    ".chip-pair": {
      "gap": "8px"
    },
    ".nav": {
      "height": "56px"
    },
    ".nav-link": {
      "height": "36px"
    },
    ".icon-btn": {
      "width": "36px",
      "height": "36px"
    },
    ".badge": {
      "height": "32px",
      "padding": "0 12px"
    },
    ".tag": {
      "height": "32px",
      "padding": "0 8px"
    },
    ".term-chip": {
      "height": "32px",
      "padding": "0 12px"
    },
    ".copy-btn": {
      "height": "32px",
      "padding": "0 12px"
    },
    ".breadcrumb a": {
      "height": "32px",
      "padding": "0 8px",
      "border-radius": "var(--radius-xs)"
    },
    ".game-ic": {
      "width": "18px",
      "height": "18px",
      "border-radius": "var(--radius-2xs)"
    },
    ".skip-link": {
      "height": "44px",
      "padding": "0 16px"
    },
    ".site-open": {
      "width": "40px",
      "height": "40px",
      "border-radius": "50%"
    },
    "main > .page-head ~ .section:first-of-type": {
      "margin-top": "48px"
    },
    ".contact-card .btn-ghost": {
      "background": "var(--panel-strong)",
      "box-shadow": "var(--rim), var(--shadow-sm)"
    },
    ".contact-card .chip-copy": {
      "background": "var(--panel-strong)",
      "box-shadow": "var(--rim), var(--shadow-sm)"
    }
  },
  "_sourceContractNote": "check-design.mjs 逐条断言这些选择器的声明值；改契约数值 = 改这里 + 改 CSS（两边必须一致）",
  "renderedContract": {
    "_note": "audit-design.py 的渲染级断言：高度档位、页级间距对、左缘同轴、半径、成对等高、对比度",
    "controlSelectors": {
      ".btn:not(.btn-sm)": 44,
      ".chip-static": 44,
      ".chip-copy": 44,
      ".btn-sm": 36,
      ".filter-chip": 36,
      ".nav-link": 36,
      ".icon-btn": 36,
      ".badge": 32,
      ".tag": 32,
      ".term-chip": 32,
      ".copy-btn": 32,
      ".site-open": 40
    },
    "pillPairHeightEqual": ["(.chip-static|.chip-copy)", "(.filter-chip|.chip-copy)"],
    "radiusChecks": {
      ".project-card": "16px",
      ".tag": "8px",
      ".game-ic": "4px",
      ".to-top": "circle",
      ".filter-chip": "pill"
    },
    "leftAxisSelectors": [".page-head", ".section", ".filter-row", ".grid", ".project-card", ".site-card"],
    "footerSticky": true,
    "uniformFillGroups": [
      {
        "label": "联系卡所有块同底色同材质",
        "root": ".contact-card",
        "childSelectors": [".btn", ".chip-copy"]
      }
    ]
  }
}
